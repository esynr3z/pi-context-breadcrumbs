{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi context-breadcrumbs extension configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "includeFilenames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": ["AGENTS.md", "AGENTS.override.md", "CLAUDE.md"]
    },
    "ignoreDirs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": [".git", "node_modules", "dist", "build", "target", ".venv", "venv", "__pycache__"]
    },
    "notifyOnLoad": { "type": "boolean", "default": true },
    "filterSupersededFromPrompt": {
      "type": "boolean",
      "default": true,
      "description": "When true, older superseded breadcrumb messages are filtered from the provider-bound prompt while visible session history remains unchanged."
    }
  }
}
